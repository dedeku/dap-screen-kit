{
  "name": "@dap/screen-kit",
  "version": "0.1.6",
  "description": "Common DAP screen runtime: single-source registry + <ScreenRenderer> over dap-design-system. One render path shared by the form-builder, the life-event flows, the player and Storybook.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "import": "./dist/schema/index.js"
    },
    "./patterns": {
      "import": "./dist/patterns/index.js"
    },
    "./field-schema.json": "./src/generated/field-schema.json",
    "./component-catalog.json": "./src/generated/component-catalog.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src/generated/field-schema.json",
    "src/generated/component-catalog.json"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepare": "tsup",
    "gen:field-schema": "node scripts/gen-field-schema.mjs",
    "gen:component-catalog": "node scripts/gen-component-catalog.mjs",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "dap-design-system": ">=0.56 <0.57",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "dap-design-system": "^0.56.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0"
  }
}
